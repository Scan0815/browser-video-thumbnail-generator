{
  "name": "browser-video-thumbnail-generator",
  "version": "2.0.3",
  "description": "This is a library for generating thumbnails from video files. It provides a simple API for extracting a single frame or multiple frames from a video and returning them as images.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/browser-video-thumbnail-generator/browser-video-thumbnail-generator.esm.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scan0815/browser-video-thumbnail-generator.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "prepare": "npm run build --prod",
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test",
    "test.watch": "stencil-test --watch",
    "test.spec": "stencil-test --project spec",
    "test.e2e": "stencil-test --project browser",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@stencil/core": "^4.43.4"
  },
  "devDependencies": {
    "@stencil/vitest": "^1.11.6",
    "@types/node": "^22.10.0",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "playwright": "^1.60.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "vitest": "^4.1.7"
  },
  "license": "MIT"
}
